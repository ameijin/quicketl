output "databases" {
  description = "Database names by environment and layer."
  value       = module.platform.databases
}

output "warehouses" {
  description = "Warehouse names by environment."
  value       = module.platform.warehouses
}

output "functional_roles" {
  description = "Functional role names by environment and role."
  value       = module.platform.functional_roles
}
{%- if spec.network.allowed_ips %}

output "network_policy" {
  description = "Network policy to attach once you have checked it includes your address."
  value       = module.network_policy.policy_name
}
{%- endif %}
{%- if spec.sources %}

output "storage_iam_user_arn" {
  description = "AWS IAM user Snowflake uses; add it to the S3 role's trust policy."
  value       = module.s3_integration.iam_user_arn
}

output "storage_external_id" {
  description = "External ID to require in the S3 role's trust policy."
  value       = module.s3_integration.external_id
}
{%- endif %}
{%- if spec.sso.provider == "okta" %}

output "okta_scim_integration" {
  description = "SCIM integration to generate Okta's provisioning token for."
  value       = module.okta_sso.scim_integration
}
{%- endif %}
