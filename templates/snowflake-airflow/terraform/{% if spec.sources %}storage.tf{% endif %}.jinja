# Storage integration that lets Snowflake read the S3 landing locations.
# Roles that write the landing layer (such as the loader) get USAGE on it so
# the Airflow DAG can create stages.

module "s3_integration" {
  source = "git::https://github.com/ameijin/quicketl.git//terraform/modules/snowflake-s3-integration?ref={{ template_ref }}"

  name                 = "${local.prefix}_S3_LANDING"
  storage_aws_role_arn = var.storage_aws_role_arn
  allowed_locations = [
{%- for location in spec.sources | map(attribute="location") | unique %}
    "{{ location }}",
{%- endfor %}
  ]
  usage_roles = module.platform.landing_writer_roles
}
