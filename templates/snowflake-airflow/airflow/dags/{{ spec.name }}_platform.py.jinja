"""{{ spec.name }}: load raw files from S3 into Snowflake, then build with dbt.

Generated by `quicketl platform scaffold`. Runs on Amazon MWAA (Airflow 3).

Setup, once per MWAA environment:
- Airflow connection `snowflake_loader` (Snowflake, key-pair auth) for loading.
- Airflow connection `snowflake_dbt` (Snowflake, key-pair auth) for dbt. Its
  extras must include `account`, `role` and `private_key_content` (PEM text).
- Airflow Variable `platform_environment`: which environment this MWAA
  environment serves ({{ spec.environments | join(", ") }}). Default: {{ spec.environments[0] }}.
"""

from __future__ import annotations

import pendulum
from airflow.providers.standard.operators.bash import BashOperator
from airflow.sdk import dag
{%- if spec.sources %}
from airflow.providers.snowflake.hooks.snowflake import SnowflakeHook
from airflow.sdk import task
{%- endif %}

PREFIX = "{{ spec.name | upper }}"
LOADER_CONN_ID = "snowflake_loader"
ENVIRONMENT = "{{ '{{' }} var.value.get('platform_environment', '{{ spec.environments[0] }}') {{ '}}' }}"

# dbt runs from the virtual environment made by startup.sh, on a copy of the
# project (MWAA's dags folder is read-only).
DBT_BIN = "/usr/local/airflow/python3-virtualenv/dbt-env/bin/dbt"
DBT_PROJECT = "/usr/local/airflow/dags/dbt"
{%- if spec.sources %}

LANDING_LAYER = "{{ spec.layers[0] | upper }}"
STORAGE_INTEGRATION = f"{PREFIX}_S3_LANDING"

# Sources from platform.yml: name, domain, S3 location and file format.
SOURCES = {{ spec.sources | tojson }}

FILE_FORMATS = {
    "parquet": "TYPE = PARQUET USE_LOGICAL_TYPE = TRUE",
    "json": "TYPE = JSON STRIP_OUTER_ARRAY = TRUE",
    "csv": "TYPE = CSV PARSE_HEADER = TRUE FIELD_OPTIONALLY_ENCLOSED_BY = '\"'",
}


@task
def load_source(source: dict[str, str], environment: str) -> None:
    """Copy new files for one source from S3 into its landing table.

    Creates the file format, stage and table on first run. COPY INTO skips
    files it has already loaded, so reruns are safe.
    """
    hook = SnowflakeHook(snowflake_conn_id=LOADER_CONN_ID)
    database = f"{PREFIX}_{environment.upper()}_{LANDING_LAYER}"
    schema = source["domain"].upper()
    table = source["name"].upper()
    file_format = f"{database}.{schema}.{table}_FORMAT"
    stage = f"{database}.{schema}.{table}_STAGE"

    hook.run(
        [
            f"CREATE FILE FORMAT IF NOT EXISTS {file_format} {FILE_FORMATS[source['format']]}",
            f"CREATE STAGE IF NOT EXISTS {stage} URL = '{source['location']}' "
            f"STORAGE_INTEGRATION = {STORAGE_INTEGRATION} "
            f"FILE_FORMAT = (FORMAT_NAME = '{file_format}')",
        ]
    )
    exists = hook.get_first(
        f"SELECT COUNT(*) FROM {database}.INFORMATION_SCHEMA.TABLES "
        "WHERE TABLE_SCHEMA = %(schema)s AND TABLE_NAME = %(table)s",
        parameters={"schema": schema, "table": table},
    )
    if not exists or not exists[0]:
        hook.run(
            f"CREATE TABLE {database}.{schema}.{table} USING TEMPLATE ("
            "SELECT ARRAY_AGG(OBJECT_CONSTRUCT(*)) FROM TABLE(INFER_SCHEMA("
            f"LOCATION => '@{stage}', FILE_FORMAT => '{file_format}')))"
        )
    hook.run(
        f"COPY INTO {database}.{schema}.{table} FROM @{stage} "
        f"FILE_FORMAT = (FORMAT_NAME = '{file_format}') "
        "MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE"
    )
{%- endif %}


@dag(
    dag_id="{{ spec.name }}_platform",
    schedule="{{ spec.orchestrator.schedule }}",
    start_date=pendulum.datetime(2026, 1, 1, tz="UTC"),
    catchup=False,
    max_active_runs=1,
    tags=["{{ spec.name }}", "quicketl"],
)
def {{ spec.name }}_platform() -> None:
    dbt_build = BashOperator(
        task_id="dbt_build",
        bash_command=(
            "set -euo pipefail; "
            'workdir="$(mktemp -d)"; '
            f'cp -R {DBT_PROJECT}/. "$workdir"; '
            'cd "$workdir"; '
            f"{DBT_BIN} build --profiles-dir . --target {ENVIRONMENT}"
        ),
        env={
            "SNOWFLAKE_ACCOUNT": "{{ '{{' }} conn.snowflake_dbt.extra_dejson.account {{ '}}' }}",
            "SNOWFLAKE_USER": "{{ '{{' }} conn.snowflake_dbt.login {{ '}}' }}",
            "SNOWFLAKE_PRIVATE_KEY": "{{ '{{' }} conn.snowflake_dbt.extra_dejson.private_key_content {{ '}}' }}",
            "DBT_SNOWFLAKE_ROLE": "{{ '{{' }} conn.snowflake_dbt.extra_dejson.role {{ '}}' }}",
        },
        append_env=True,
    )
{%- if spec.sources %}

    load_source.partial(environment=ENVIRONMENT).expand(source=SOURCES) >> dbt_build
{%- endif %}


{{ spec.name }}_platform()
